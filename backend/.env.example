# Grounded EDI Layer-3 deliberation (Explain / Suggest / Explore / Compare)
# Without a provider, API returns structured fallbacks.

EDI_LLM_ENABLED=true

# --- Option A: local Ollama (free, private; no API key needed) ---
EDI_LLM_BASE_URL=http://127.0.0.1:11434/v1
EDI_LLM_MODEL=llama3.2
EDI_LLM_JSON_FORMAT=false

# --- Option B: OpenAI (paid credits) ---
# EDI_LLM_API_KEY=sk-...
# EDI_LLM_BASE_URL=https://api.openai.com/v1
# EDI_LLM_MODEL=gpt-4o-mini
# EDI_LLM_JSON_FORMAT=true
